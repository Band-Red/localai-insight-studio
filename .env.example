# Example Environment Configuration for LocalAI Insight Studio
# Copy this file to .env and adjust values as needed.
# NEVER commit your actual .env file with real credentials to GitHub.

# Application Environment
NODE_ENV=your_node_env # بيئة تشغيل التطبيق (مثال: development أو production)
PORT=your_port # منفذ تشغيل التطبيق (مثال: 3000)

# Local AI Engine Settings
ENGINE_HOST=your_host_IP # عنوان IP لخادم المحرك المحلي (مثال: 127.0.0.1)
ENGINE_PORT=your_port_engin # منفذ تشغيل محرك الذكاء الاصطناعي (مثال: 8080)

# Database Configuration (إن وُجد)
DB_HOST=your_db_host # عنوان خادم قاعدة البيانات
DB_PORT=your_db_port # منفذ خادم قاعدة البيانات
DB_NAME=your_db_name # اسم قاعدة البيانات
DB_USER=your_db_user # اسم مستخدم قاعدة البيانات
DB_PASS=your_db_password # كلمة مرور قاعدة البيانات (لا تضع القيمة الحقيقية هنا)

# API Keys & Secrets (إن وُجد)
API_KEY=your_api_key # مفتاح الـ API الخاص بالخدمة
JWT_SECRET=your_jwt_secret # مفتاح التشفير السري لـ JWT

# Logging & Telemetry
LOG_LEVEL=your_log_level # مستوى السجلات (مثال: info أو debug أو error)
ENABLE_LOCAL_METRICS=your_enable_metrics # تفعيل جمع المقاييس المحلية (true أو false)
