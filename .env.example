# Example Environment Configuration for LocalAI Insight Studio
# Copy this file to .env and adjust values as needed.
# NEVER commit your actual .env file with real credentials to GitHub.

# Application Environment
NODE_ENV=development
PORT=3000

# Local AI Engine Settings
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8080

# Logging & Telemetry
LOG_LEVEL=info
ENABLE_LOCAL_METRICS=true
